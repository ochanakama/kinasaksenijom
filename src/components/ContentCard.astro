---
import type { ImageMetadata } from 'astro';
import SeoImage from './SeoImage.astro';
import Icon from './Icon.astro';
interface Props { href: string; title: string; description: string; image: ImageMetadata; alt: string; eyebrow?: string; }
const { href, title, description, image, alt, eyebrow } = Astro.props;
---

<article class="content-card surface">
  <a href={href} aria-label={title}>
    <SeoImage src={image} alt={alt} width={720} height={480} widths={[360, 540, 720]} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw" />
    <div class="content-card__body">
      {eyebrow && <p>{eyebrow}</p>}
      <h2>{title}</h2>
      <span>{description}</span>
      <span class="content-card__link">Saznaj više <Icon name="arrow" size={18} /></span>
    </div>
  </a>
</article>

<style>
  .content-card { overflow: hidden; }
  a { display: grid; height: 100%; color: inherit; text-decoration: none; }
  :global(.content-card img) { width: 100%; height: auto; aspect-ratio: 3/2; object-fit: cover; filter: saturate(.72); transition: transform 350ms ease, filter 350ms ease; }
  a:hover :global(img) { transform: scale(1.025); filter: saturate(1); }
  .content-card__body { display: grid; align-content: start; gap: .8rem; padding: 1.5rem; }
  p { margin: 0; color: var(--brass); font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1; }
  .content-card__body > span:not(.content-card__link) { color: var(--paper-muted); font-size: .9rem; }
  .content-card__link { display: inline-flex; align-items: center; gap: .55rem; margin-top: .5rem; color: var(--vermilion); font-size: .8rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
</style>
