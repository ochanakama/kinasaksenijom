---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  sizes = '100vw',
  widths,
  priority = false,
  class: className,
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  class={className}
/>
