---
import JsonLd from './JsonLd.astro';

interface Question { pitanje: string; odgovor: string; }
interface Props { heading: string; questions: Question[]; variant?: 'default' | 'home'; }
const { heading, questions, variant = 'default' } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((item) => ({
    '@type': 'Question',
    name: item.pitanje,
    acceptedAnswer: { '@type': 'Answer', text: item.odgovor },
  })),
};
---

<section class:list={['faq', 'section', variant === 'home' && 'faq--home']} aria-labelledby="faq-heading">
  <div class="container faq__inner">
    <div class="section-heading">
      <p class="eyebrow">Važno pre puta</p>
      <h2 id="faq-heading">{heading}</h2>
    </div>
    <div class="faq__list">
      {questions.map((item) => (
        <details>
          <summary>{item.pitanje}<span aria-hidden="true">+</span></summary>
          <p>{item.odgovor}</p>
        </details>
      ))}
    </div>
  </div>
  <JsonLd data={schema} />
</section>

<style>
  .faq { background: var(--ink-900); }
  .faq .eyebrow { color: var(--vermilion); }
  .faq__inner { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 8vw, 7rem); }
  .faq__list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { display: flex; min-height: 5rem; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer; font-weight: 700; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary span { color: var(--brass); font-family: var(--font-display); font-size: 1.8rem; transition: transform 180ms ease; }
  details[open] summary span { transform: rotate(45deg); }
  details p { max-width: 43rem; padding: 0 2rem 1.5rem 0; color: var(--paper-muted); }
  .faq--home { position: relative; overflow: hidden; background: #fffaf1; }
  .faq--home::before { position: absolute; bottom: -3rem; left: -5rem; width: 19rem; aspect-ratio: 1; border: 1px solid rgba(181,21,29,.18); border-radius: 50%; content: ''; box-shadow: 0 0 0 2rem rgba(197,151,72,.035), 0 0 0 4rem rgba(181,21,29,.025); }
  .faq--home .faq__inner { position: relative; }
  .faq--home .section-heading { align-content: start; }
  .faq--home .section-heading::after { width: 5.5rem; height: .45rem; margin-top: .5rem; transform: rotate(-3deg); background: var(--vermilion); clip-path: polygon(0 35%, 100% 0, 91% 60%, 9% 100%); content: ''; opacity: .8; }
  .faq--home .eyebrow { color: #986a21; }
  .faq--home h2 { color: var(--text); font-size: clamp(2.6rem, 5vw, 4.7rem); }
  .faq--home .faq__list { border-color: rgba(105,76,50,.22); }
  .faq--home details { border-color: rgba(105,76,50,.22); }
  .faq--home summary { color: var(--text); }
  .faq--home summary span { color: var(--vermilion); }
  .faq--home details p { color: var(--text-muted); }
  @media (max-width: 48rem) { .faq__inner { grid-template-columns: 1fr; } .section-heading { margin-bottom: 0; } }
</style>
