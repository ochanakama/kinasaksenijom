---
import { Image } from 'astro:assets';
import logoImage from '../kinasaksenijom-kruz-providna-pozadina.png';
---

<footer class="site-footer">
  <div class="container site-footer__top">
    <div>
      <a class="footer-brand" href="/"><Image src={logoImage} alt="" width={56} loading="lazy" />Kina sa Ksenijom</a>
      <p>Organizovana putovanja u Kinu iz Srbije i regiona, u malim grupama i uz lično vođenje.</p>
    </div>
    <nav aria-label="Destinacije">
      <strong>Destinacije</strong>
      <a href="/destinacije/sangaj/">Šangaj</a>
      <a href="/destinacije/peking/">Peking</a>
      <a href="/destinacije/sanya-hainan/">Hainan</a>
    </nav>
    <nav aria-label="Sadržaj">
      <strong>Istraži</strong>
      <a href="/ture/">Ture</a>
      <a href="/blog/">Blog</a>
    </nav>
    <div class="contact">
      <strong>Kontakt</strong>
      <a href="/kontakt/">Kontakt forma</a>
      <a href="mailto:info@kinasaksenijom.com">info@kinasaksenijom.com</a>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <span>© {new Date().getFullYear()} Kina sa Ksenijom</span>
    <a href="/sitemap-index.xml">Mapa sajta</a>
  </div>
</footer>

<style>
  .site-footer { --footer-gold: #d8ad59; --footer-gold-light: #f1d08b; border-top: 1px solid rgba(216,173,89,.34); background: #1f1715; color: var(--footer-gold); }
  .site-footer__top { display: grid; grid-template-columns: 1.5fr .75fr .75fr 1fr; gap: 3rem; padding-block: 4.5rem; }
  .footer-brand { display: inline-flex; align-items: center; gap: .8rem; color: var(--footer-gold-light); font-family: var(--font-script); font-size: 1.85rem; font-weight: 400; letter-spacing: 0; line-height: .95; text-decoration: none; text-transform: none; }
  .footer-brand :global(img) { width: 3.5rem; height: 3.5rem; border: 1px solid rgba(216,173,89,.7); border-radius: 50%; background: #fffaf1; box-shadow: 0 7px 18px rgba(0,0,0,.22); object-fit: contain; }
  p { max-width: 25rem; margin-top: 1rem; color: var(--footer-gold); font-size: .9rem; }
  nav, .contact { display: grid; align-content: start; gap: .6rem; }
  strong { margin-bottom: .35rem; color: var(--footer-gold-light); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; }
  nav a, .contact a { color: var(--footer-gold); font-size: .86rem; text-decoration: none; }
  nav a:hover, .contact a:hover, .site-footer__bottom a:hover { color: var(--footer-gold-light); }
  small { max-width: 16rem; color: var(--footer-gold); line-height: 1.5; }
  .site-footer__bottom { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.2rem; border-top: 1px solid rgba(216,173,89,.28); color: var(--footer-gold); font-size: .72rem; }
  .site-footer__bottom a { color: inherit; }
  @media (max-width: 52rem) { .site-footer__top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 34rem) { .site-footer__top { grid-template-columns: 1fr; } }
</style>
