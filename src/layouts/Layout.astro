---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import logoImage from '../kinasaksenijom-kruz-providna-pozadina.png';
import displayFontLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import displayFontLatinExt from '@fontsource-variable/fraunces/files/fraunces-latin-ext-wght-normal.woff2?url';
import bodyFontLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import bodyFontLatinExt from '@fontsource-variable/dm-sans/files/dm-sans-latin-ext-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  ogImage = '/og/default.jpg',
  ogImageAlt = 'Kina sa Ksenijom',
  noindex = false,
} = Astro.props;
const absoluteOgImage = new URL(ogImage, Astro.site).href;
const favicon = await getImage({ src: logoImage, width: 64, format: 'png' });
const fontPreloads = [
  { href: displayFontLatin, type: 'font/woff2' },
  { href: displayFontLatinExt, type: 'font/woff2' },
  { href: bodyFontLatin, type: 'font/woff2' },
  { href: bodyFontLatinExt, type: 'font/woff2' },
];
---

<!doctype html>
<html lang="sr-Latn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon.src} type="image/png" />
    {fontPreloads.map((font) => <link rel="preload" href={font.href} as="font" type={font.type} crossorigin />)}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kina sa Ksenijom" />
    <meta property="og:locale" content="sr_RS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Pređi na sadržaj</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
