---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SeoImage from '../../components/SeoImage.astro';
import Faq from '../../components/Faq.astro';
import JsonLd from '../../components/JsonLd.astro';
import Icon from '../../components/Icon.astro';
import { resolveImage } from '../../lib/images';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'blog'>; }
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const [destinations, blogs, tours] = await Promise.all([
  getCollection('destinacije', ({ data }) => !data.draft),
  getCollection('blog', ({ data }) => !data.draft),
  getCollection('ture', ({ data }) => !data.draft),
]);
const destinationMap = new Map(destinations.map((item) => [item.id, item]));
const blogMap = new Map(blogs.map((item) => [item.id, item]));
const tourMap = new Map(tours.map((item) => [item.id, item]));
const relatedDestinations = entry.data.povezaneDestinacije.map((id) => destinationMap.get(id)).filter(Boolean) as CollectionEntry<'destinacije'>[];
const relatedBlogs = entry.data.povezaniBlogovi.map((id) => blogMap.get(id)).filter(Boolean) as CollectionEntry<'blog'>[];
const relatedTours = entry.data.povezaneTure.map((id) => tourMap.get(id)).filter(Boolean) as CollectionEntry<'ture'>[];
const hero = resolveImage(entry.data.heroImage);
const canonical = new URL(`/blog/${entry.id}/`, Astro.site).href;
const formatDate = (date: Date) => new Intl.DateTimeFormat('sr-Latn-RS', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.naslov,
  description: entry.data.description,
  image: new URL(hero.src, Astro.site).href,
  datePublished: entry.data.datumObjave.toISOString(),
  dateModified: (entry.data.datumIzmene ?? entry.data.datumObjave).toISOString(),
  inLanguage: 'sr-Latn',
  author: { '@type': 'Person', name: entry.data.autor },
  mainEntityOfPage: canonical,
};
---

<Layout title={entry.data.title} description={entry.data.description} canonical={canonical} ogImage={hero.src} ogImageAlt={entry.data.heroImageAlt} noindex={entry.data.noindex}>
  <JsonLd data={schema} />
  <article>
    <header class="post-hero">
      <div class="container">
        <Breadcrumbs items={[{ label: 'Početna', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: entry.data.naslov }]} />
        <div class="post-hero__copy">
          <p class="eyebrow">{entry.data.kategorija}</p>
          <h1>{entry.data.naslov}</h1>
          <p class="lead">{entry.data.uvod}</p>
          <div class="post-meta">
            <span>{entry.data.autor}</span><span>{formatDate(entry.data.datumObjave)}</span>
            {entry.data.vremeCitanja && <span>{entry.data.vremeCitanja} min čitanja</span>}
          </div>
        </div>
      </div>
    </header>
    <div class="container post-image">
      <SeoImage src={hero} alt={entry.data.heroImageAlt} width={1440} height={810} widths={[720, 1100, 1440]} sizes="(max-width: 1280px) 100vw, 1240px" priority />
    </div>
    <section class="section post-body">
      <div class="prose"><Content /></div>
    </section>
  </article>

  {entry.data.faq && <Faq heading="Česta pitanja" questions={entry.data.faq} />}

  {(relatedDestinations.length > 0 || relatedBlogs.length > 0 || relatedTours.length > 0) && (
    <section class="related section" aria-labelledby="related-heading">
      <div class="container">
        <div class="section-heading"><p class="eyebrow">Nastavite čitanje</p><h2 id="related-heading">Povezane stranice</h2></div>
        <div class="related__links">
          {relatedDestinations.map((item) => <a href={`/destinacije/${item.id}/`}><span>Destinacija</span><strong>{item.data.naslov}</strong><Icon name="arrow" size={20} /></a>)}
          {relatedBlogs.map((item) => <a href={`/blog/${item.id}/`}><span>Blog</span><strong>{item.data.naslov}</strong><Icon name="arrow" size={20} /></a>)}
          {relatedTours.map((item) => <a href={`/ture/${item.id}/`}><span>Tura</span><strong>{item.data.naslov}</strong><Icon name="arrow" size={20} /></a>)}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .post-hero { padding: 6.5rem 0 clamp(3rem, 7vw, 6rem); background: radial-gradient(circle at 85% 20%, rgba(156,14,21,.11), transparent 28rem); }
  .post-hero__copy { max-width: 68rem; padding-top: clamp(2rem, 5vw, 4rem); }
  .post-hero h1 { font-size: clamp(3.2rem, 7vw, 6.6rem); }
  .post-hero .lead { margin: 2rem 0; }
  .post-meta { display: flex; flex-wrap: wrap; gap: .6rem 1.5rem; color: var(--paper-muted); font-size: .78rem; font-weight: 700; text-transform: uppercase; }
  .post-meta span + span::before { margin-right: 1.5rem; color: var(--brass); content: '•'; }
  .post-image { position: relative; z-index: 2; margin-bottom: -4rem; }
  .post-image :global(img) { width: 100%; height: auto; max-height: 44rem; border-radius: var(--radius); object-fit: cover; box-shadow: var(--shadow); }
  .post-body { padding-top: 10rem; background: var(--surface); color: var(--text); }
  .post-body :global(.prose) { color: #474039; }
  .post-body :global(.prose h2), .post-body :global(.prose h3) { color: var(--text); }
  .post-body :global(.prose a) { color: var(--vermilion); }
  .related__links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .related__links a { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: .35rem 1rem; padding: 1.4rem; border: 1px solid var(--line); border-radius: var(--radius-sm); text-decoration: none; }
  .related__links a:hover { border-color: var(--brass); }
  .related__links span { grid-column: 1; color: var(--brass); font-size: .65rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .related__links strong { grid-column: 1; line-height: 1.35; }
  .related__links :global(svg) { grid-column: 2; grid-row: 1 / 3; }
  @media (max-width: 58rem) { .post-hero { padding-top: 5.25rem; } }
  @media (max-width: 48rem) { .related__links { grid-template-columns: 1fr; } .post-meta span + span::before { display: none; } }
</style>
