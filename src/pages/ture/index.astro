---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getOrganizationReference, getSchemaIds } from '../../lib/schema';

const title = 'Organizovane ture u Kinu | Kina sa Ksenijom';
const description = 'Prva tura u Kinu uskoro stiže. Ostavi kontakt i saznaj među prvima nove termine, plan putovanja i detalje organizovanih polazaka iz Srbije.';
const canonical = new URL('/ture/', Astro.site).href;
const schemaIds = getSchemaIds(Astro.site);
const toursSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'sr-Latn',
  isPartOf: { '@id': schemaIds.website },
  publisher: getOrganizationReference(Astro.site),
};
---

<Layout title={title} description={description} canonical={canonical}>
  <JsonLd data={toursSchema} />
  <div class="tours-page">
    <div class="tours-page__breadcrumbs">
      <Breadcrumbs items={[{ label: 'Početna', href: '/' }, { label: 'Ture' }]} />
    </div>

    <section class="tours-notice section" aria-labelledby="tours-heading">
      <div class="container tours-notice__inner surface">
        <p class="eyebrow">Novi polasci su u pripremi</p>
        <h1 id="tours-heading">Prva tura uskoro stiže</h1>
        <p>Rute, datume i veličinu grupa objavljujem kada su svi detalji potvrđeni. Prijave interesovanja otvaram zajedno sa terminima.</p>
        <a class="button" href="/kontakt/">Ostavi kontakt <Icon name="arrow" size={18} /></a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .tours-page {
    min-height: 70svh;
    padding-top: 6.5rem;
    background: var(--surface-alt);
  }

  .tours-page__breadcrumbs {
    padding-top: .4rem;
  }

  .tours-page__breadcrumbs :global(.breadcrumbs) {
    margin-block: 0;
  }

  .tours-notice {
    padding-top: clamp(.75rem, 1.5vw, 1.25rem);
  }

  .tours-notice__inner {
    display: grid;
    max-width: 72rem;
    justify-items: center;
    padding: clamp(3.5rem, 8vw, 7rem) clamp(1.5rem, 7vw, 5rem);
    text-align: center;
  }

  .tours-notice .eyebrow {
    justify-content: center;
  }

  .tours-notice h1 {
    max-width: 13ch;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    font-size: clamp(3rem, 7vw, 6rem);
  }

  .tours-notice__inner > p:not(.eyebrow) {
    max-width: 42rem;
    margin: 1.5rem auto 2rem;
    color: var(--paper-muted);
  }

  @media (max-width: 58rem) {
    .tours-page {
      padding-top: 5.25rem;
    }
  }

  @media (max-width: 42rem) {
    .tours-notice__inner {
      padding-inline: 1.25rem;
    }

    .tours-notice .button {
      width: 100%;
    }
  }
</style>
