---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SeoImage from '../components/SeoImage.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import { getOrganizationReference, getSchemaIds } from '../lib/schema';
import authorImage from '../assets/hero/ks_kina.jpg';
import previewContents from '../assets/china-ready/sadrzaj.png';
import previewAlipay from '../assets/china-ready/alipay.png';
import previewPhrases from '../assets/china-ready/osnovne-fraze.png';
import guideCover from '../chinareadyslika.png';

const landingPages = await getCollection('landing');
const page = landingPages.find((entry) => entry.id === 'china-ready-vodic');
if (!page) throw new Error('Nedostaje src/content/landing/china-ready-vodic.md');

const { seo, purchaseUrl, hero, problem, sadrzaj, bonusi, preview, autor, faq, zavrsniCta } = page.data;
const previewImages = [previewContents, previewAlipay, previewPhrases] as const;
const schemaIds = getSchemaIds(Astro.site);
const bookSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  '@id': `${seo.canonical}#book`,
  name: 'China Ready',
  description: seo.description,
  url: seo.canonical,
  image: new URL(guideCover.src, Astro.site).href,
  inLanguage: 'sr-Latn',
  bookFormat: 'https://schema.org/EBook',
  author: {
    '@type': 'Person',
    '@id': schemaIds.person,
    name: 'Ksenija',
    url: new URL('/o-meni/', Astro.site).href,
  },
  publisher: getOrganizationReference(Astro.site),
};
---

<Layout title={seo.title} description={seo.description} canonical={seo.canonical} ogImageAlt={hero.imageAlt}>
  <JsonLd data={bookSchema} />

  <section class="guide-hero" aria-labelledby="guide-title">
    <Breadcrumbs items={[{ label: 'Početna', href: '/' }, { label: 'China Ready vodič' }]} />
    <div class="container guide-hero__grid">
      <div class="guide-hero__copy">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 id="guide-title">{hero.naslov}</h1>
        <p class="guide-hero__lead">{hero.lead}</p>
        <p class="guide-hero__description">{hero.opis}</p>
        <p class="guide-highlights"><Icon name="check-circle" size={20} />{hero.istaknuto}</p>
        <div class="guide-hero__purchase">
          <a class="button guide-button" href={purchaseUrl}>{hero.cta}</a>
          <small class="purchase-note">{hero.microcopy}</small>
        </div>
      </div>

      <div class="guide-hero__visual">
        <figure class="guide-phone">
          <div class="guide-phone__device">
            <span class="guide-phone__speaker" aria-hidden="true"></span>
            <div class="guide-phone__screen">
              <SeoImage
                src={guideCover}
                alt="Naslovna stranica China Ready digitalnog vodica"
                width={guideCover.width}
                height={guideCover.height}
                widths={[280, 360, 453]}
                sizes="(max-width: 48rem) 72vw, 21rem"
                priority
                class="guide-phone__image"
              />
            </div>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <section class="problem section" aria-labelledby="problem-heading">
    <div class="container problem__inner">
      <div class="problem__visual">
        <span class="problem__ornament problem__ornament--top" aria-hidden="true"></span>
        <div class="problem__cards">
          {problem.izazovi.map((izazov) => (
            <div class="problem-card">
              <strong lang="zh-Hans">{izazov.znak}</strong>
              <span>{izazov.naslov}</span>
            </div>
          ))}
        </div>
        <span class="problem__ornament problem__ornament--bottom" aria-hidden="true"></span>
      </div>
      <div class="problem__copy">
        <p class="problem__eyebrow">{problem.eyebrow}</p>
        <h2 id="problem-heading">{problem.naslov}</h2>
        {problem.paragrafi.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="contents section" aria-labelledby="contents-heading">
    <div class="container">
      <header class="section-heading guide-section-heading">
        <p class="contents__eyebrow">{sadrzaj.eyebrow}</p>
        <h2 id="contents-heading">{sadrzaj.naslov}</h2>
        <p>{sadrzaj.uvod}</p>
      </header>
      <div class="topic-grid">
        {sadrzaj.teme.map((tema) => (
          <article class="topic-card">
            <span class="topic-card__icon"><Icon name={tema.ikonica} size={28} /></span>
            <h3>{tema.naslov}</h3>
            <ul>{tema.stavke.map((stavka) => <li>{stavka}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bonuses section" aria-labelledby="bonuses-heading">
    <div class="container">
      <header class="section-heading guide-section-heading guide-section-heading--center">
        <h2 id="bonuses-heading">{bonusi.naslov}</h2>
      </header>
      <div class="bonus-list" aria-label="Bonus materijali">
        {bonusi.stavke.map((bonus, index) => (
          <article class="bonus-card">
            <span>0{index + 1}</span>
            <h3>{bonus.naslov}</h3>
            <p>{bonus.opis}</p>
          </article>
        ))}
      </div>
      <div class="section-purchase">
        <a class="button guide-button" href={purchaseUrl}>{bonusi.cta}<Icon name="arrow" size={19} /></a>
        <small class="purchase-note">{bonusi.microcopy}</small>
      </div>
    </div>
  </section>

  <section class="preview section" aria-labelledby="preview-heading">
    <div class="container">
      <header class="section-heading guide-section-heading">
        <p class="preview__eyebrow">{preview.eyebrow}</p>
        <h2 id="preview-heading">{preview.naslov}</h2>
        <p>{preview.opis}</p>
      </header>
      <div class="preview-list">
        {preview.stavke.map((item, index) => {
          const image = previewImages[index];

          return (
            <figure class="preview-card">
              <div class="preview-card__media">
                <SeoImage
                  src={image}
                  alt={item.alt}
                  width={image.width}
                  height={image.height}
                  sizes="(max-width: 48rem) 78vw, 30vw"
                  class="preview-card__image"
                />
              </div>
              <figcaption>{item.naslov}</figcaption>
            </figure>
          );
        })}
      </div>
    </div>
  </section>

  <section class="author section" aria-labelledby="author-heading">
    <div class="container author__grid">
      <div class="author__image">
        <SeoImage
          src={authorImage}
          alt={autor.imageAlt}
          width={713}
          height={620}
          widths={[420, 620, 713]}
          sizes="(max-width: 48rem) calc(100vw - 2rem), 45vw"
        />
      </div>
      <div class="author__copy">
        <h2 id="author-heading">{autor.naslov}</h2>
        {autor.paragrafi.map((paragraph) => <p>{paragraph}</p>)}
        <a class="text-link" href={autor.linkHref}>{autor.linkLabel}<Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <Faq heading={faq.naslov} questions={faq.pitanja} eyebrow="" />

  <section class="final-cta section" aria-labelledby="final-cta-heading">
    <div class="container final-cta__inner">
      <h2 id="final-cta-heading">{zavrsniCta.naslov}</h2>
      <p>{zavrsniCta.tekst}</p>
      <a class="button guide-button guide-button--light" href={purchaseUrl}>{zavrsniCta.cta}<Icon name="arrow" size={19} /></a>
      <small>{zavrsniCta.microcopy}</small>
    </div>
  </section>
</Layout>

<style>
  .guide-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(7rem, 9vw, 9rem) 0 clamp(4.5rem, 8vw, 7rem);
    background: #fffaf1;
  }
  .guide-hero::before,
  .guide-hero::after {
    position: absolute;
    border: 1px solid rgba(156, 14, 21, .12);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }
  .guide-hero::before { top: 7rem; right: -13rem; width: 36rem; aspect-ratio: 1; box-shadow: 0 0 0 2.5rem rgba(138, 98, 31, .045); }
  .guide-hero::after { bottom: -17rem; left: -12rem; width: 30rem; aspect-ratio: 1; }
  .guide-hero :global(.breadcrumbs) { position: absolute; top: 6.25rem; left: 50%; z-index: 2; transform: translateX(-50%); }
  .guide-hero__grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(22rem, .75fr); align-items: center; gap: clamp(3rem, 8vw, 7rem); }
  .guide-hero__copy { min-width: 0; transform: translateY(-1rem); }
  .guide-hero .eyebrow,
  .problem__eyebrow,
  .guide-section-heading .contents__eyebrow,
  .guide-section-heading .preview__eyebrow { font-family: var(--font-body); font-size: 13.76px; font-weight: 800; letter-spacing: .12em; line-height: 1.2; text-transform: uppercase; }
  .guide-hero .eyebrow { color: #94651d; }
  .guide-hero h1 { max-width: 12ch; color: var(--text); font-size: clamp(3.6rem, 6.5vw, 6.6rem); line-height: .93; }
  .guide-hero__lead { max-width: 42rem; margin: 1.6rem 0 .75rem; color: var(--vermilion); font-size: clamp(1.25rem, 2vw, 1.65rem); font-weight: 700; line-height: 1.4; }
  .guide-hero__description { max-width: 43rem; margin-bottom: 1.2rem; color: var(--text-muted); font-size: 1.02rem; }
  .guide-highlights { display: flex; width: fit-content; max-width: 42rem; align-items: center; gap: .7rem; margin-bottom: 1.5rem; color: #a06d19; font-size: .84rem; font-weight: 800; letter-spacing: .035em; line-height: 1.4; text-transform: uppercase; }
  .guide-highlights :global(svg) { flex: 0 0 auto; color: #a87522; stroke-width: 2.2; }
  .guide-hero__purchase { display: grid; width: fit-content; justify-items: center; }
  .guide-hero__purchase .guide-button { font-size: .93rem; font-weight: 800; letter-spacing: .015em; }
  .guide-button { min-height: 3.7rem; padding-inline: 1.7rem; box-shadow: 0 12px 28px rgba(133, 16, 22, .18); }
  .purchase-note { display: block; margin-top: .65rem; color: var(--text-muted); font-size: .75rem; }
  .guide-hero__visual { min-width: 0; }
  .guide-phone { position: relative; width: min(88%, 22rem); margin: 0 auto; padding: 1rem 0 1.65rem; }
  .guide-phone::before { position: absolute; right: -.5rem; bottom: .5rem; left: -.5rem; height: 2.2rem; border-radius: 50%; background: rgba(64, 38, 30, .2); content: ''; filter: blur(16px); }
  .guide-phone__device { position: relative; padding: .75rem; transform: rotate(2deg); border: 1px solid #2d2422; border-radius: 2.2rem; background: #2b2523; box-shadow: 0 28px 60px rgba(71, 39, 28, .23); }
  .guide-phone__speaker { position: absolute; z-index: 1; top: .34rem; left: 50%; width: 3.25rem; height: .25rem; transform: translateX(-50%); border-radius: 999px; background: #5b514d; }
  .guide-phone__screen { overflow: hidden; border-radius: 1.55rem; background: #f4e5cc; }
  .guide-phone__screen :global(.guide-phone__image) { display: block; width: 100%; height: auto; }

  .problem { position: relative; overflow: hidden; background: radial-gradient(circle at 20% 48%, rgba(156,14,21,.08), transparent 34%), radial-gradient(circle at 78% 45%, rgba(197,151,72,.045), transparent 31%), #251e1c; color: #f7ead8; }
  .problem__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .95fr); align-items: center; gap: clamp(3rem, 7vw, 6.5rem); }
  .problem__visual { position: relative; display: grid; min-width: 0; min-height: 31rem; place-items: center; }
  .problem__cards { display: flex; width: 100%; align-items: center; justify-content: center; padding: 2.25rem 0; }
  .problem-card { position: relative; display: flex; width: min(31%, 13rem); aspect-ratio: .72; flex: 0 0 auto; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; margin-inline: -.35rem; padding: 1.6rem 1.15rem; border: 1px solid #c49a54; border-radius: .65rem; background: radial-gradient(circle at 35% 25%, rgba(197,151,72,.1), transparent 28%), #f7ead5; color: #241d1b; text-align: center; box-shadow: 0 20px 45px rgba(0,0,0,.28); }
  .problem-card::before { position: absolute; inset: .7rem; border: 1px solid rgba(166,113,31,.68); border-radius: .25rem; content: ''; pointer-events: none; }
  .problem-card:nth-child(1) { z-index: 1; transform: translateY(1.15rem) rotate(-9deg); }
  .problem-card:nth-child(2) { z-index: 3; width: min(34%, 14.25rem); }
  .problem-card:nth-child(3) { z-index: 2; transform: translateY(1.15rem) rotate(9deg); }
  .problem-card strong { position: relative; color: var(--vermilion); font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2.8rem, 4.5vw, 4.4rem); font-weight: 700; line-height: 1; white-space: nowrap; }
  .problem-card span { position: relative; max-width: 8ch; font-size: clamp(.95rem, 1.45vw, 1.25rem); font-weight: 600; line-height: 1.35; }
  .problem__ornament { position: absolute; width: 17rem; height: 4rem; opacity: .45; pointer-events: none; }
  .problem__ornament::before, .problem__ornament::after { position: absolute; content: ''; }
  .problem__ornament::before { width: 100%; border-top: 1px solid #b9893d; }
  .problem__ornament::after { width: 2.5rem; height: 2.5rem; border: 1px solid #b9893d; box-shadow: 1rem 1rem 0 -1px #251e1c, 1rem 1rem 0 0 #b9893d; }
  .problem__ornament--top { top: 0; left: 2rem; }
  .problem__ornament--bottom { right: 1.5rem; bottom: 0; transform: rotate(180deg); }
  .problem__copy { min-width: 0; }
  .problem__eyebrow { margin: 0 0 1.35rem; color: #d5a64e; }
  .problem h2 { max-width: 13ch; margin-bottom: 2rem; color: #fff4e3; font-size: clamp(2.8rem, 4.6vw, 4.5rem); line-height: .98; }
  .problem__copy > p:not(.problem__eyebrow) { max-width: 39rem; color: #dfd0c4; font-size: clamp(1rem, 1.3vw, 1.15rem); line-height: 1.65; }
  .problem__copy > p + p { margin-top: 1.25rem; }

  .contents { padding-top: clamp(4rem, 6vw, 6rem); background: radial-gradient(circle at 48% 35%, rgba(197,151,72,.07), transparent 38%), #fffaf1; }
  .contents .guide-section-heading { width: 100%; max-width: 57rem; justify-items: start; gap: 0; }
  .contents .guide-section-heading h2 { max-width: 18ch; font-size: clamp(3rem, 5.2vw, 5rem); line-height: .98; }
  .contents .guide-section-heading h2 + p { margin-top: 1.8rem; }
  .guide-section-heading p { max-width: 43rem; margin: 0; color: var(--text-muted); font-size: 1.05rem; line-height: 1.55; }
  .guide-section-heading .contents__eyebrow,
  .guide-section-heading .preview__eyebrow { margin: 0 0 1.35rem; color: var(--vermilion); }
  .guide-section-heading--center { margin-inline: auto; text-align: center; }
  .topic-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.35rem; }
  .topic-card { position: relative; display: grid; min-height: 17rem; grid-template-columns: 4.25rem 1fr; align-content: start; gap: 0 1.35rem; overflow: hidden; padding: clamp(1.7rem, 3vw, 2.35rem); border: 1px solid rgba(181,128,43,.48); border-radius: .35rem; background: linear-gradient(135deg, rgba(255,250,241,.96), rgba(247,232,210,.78)); box-shadow: 0 12px 28px rgba(84,53,35,.1), inset 0 0 30px rgba(197,151,72,.04); }
  .topic-card::before, .topic-card::after { position: absolute; z-index: 2; width: 3.7rem; height: 3.7rem; background: linear-gradient(#bc8732, #bc8732) 100% 0 / 3.15rem 1px no-repeat, linear-gradient(#bc8732, #bc8732) 100% 0 / 1px 3.15rem no-repeat; content: ''; opacity: .72; pointer-events: none; }
  .topic-card::before { top: .75rem; right: .75rem; }
  .topic-card::after { bottom: .75rem; left: .75rem; transform: rotate(180deg); }
  .topic-card__icon { position: relative; z-index: 1; display: grid; width: 4rem; height: 4rem; grid-row: 1; align-self: center; place-items: center; border: 1px solid rgba(156,14,21,.38); border-radius: 50%; color: var(--vermilion); box-shadow: inset 0 0 0 .42rem rgba(255,250,241,.78), 0 0 0 1px rgba(197,151,72,.18); }
  .topic-card__icon :global(svg) { width: 1.85rem; height: 1.85rem; stroke-width: 2; }
  .topic-card h3 { position: relative; z-index: 1; align-self: center; font-size: clamp(1.65rem, 2.4vw, 2.2rem); line-height: 1.05; }
  .topic-card ul { position: relative; z-index: 1; grid-column: 2; margin: 1.25rem 0 0; padding: 0; color: #4e413b; font-size: 1.06rem; line-height: 1.55; list-style: none; }
  .topic-card li { position: relative; padding-left: 1.25rem; }
  .topic-card li::before { position: absolute; top: .7em; left: 0; width: .32rem; height: .32rem; transform: rotate(45deg); background: var(--brass); content: ''; }
  .topic-card li + li { margin-top: .48rem; }
  @media (hover: hover) and (pointer: fine) {
    .topic-card {
      transform-origin: center;
      transition: transform 250ms ease, border-color 250ms ease, background 250ms ease, box-shadow 250ms ease;
    }
    .topic-card::before,
    .topic-card::after { transition: opacity 250ms ease; }
    .topic-card__icon { transition: color 250ms ease, border-color 250ms ease, box-shadow 250ms ease; }
    .topic-card:hover {
      transform: translateY(-3px) scale(1.015);
      border-color: color-mix(in srgb, var(--brass) 78%, #d9b363);
      background: linear-gradient(135deg, var(--on-dark), #f9ead4);
      box-shadow: 0 18px 40px rgba(84, 53, 35, .17), 0 0 0 3px rgba(197, 151, 72, .08), inset 0 0 34px rgba(197, 151, 72, .07);
    }
    .topic-card:hover::before,
    .topic-card:hover::after { opacity: .95; }
    .topic-card:hover .topic-card__icon {
      border-color: color-mix(in srgb, var(--vermilion-bright) 76%, transparent);
      color: var(--vermilion-bright);
      box-shadow: inset 0 0 0 .42rem rgba(255, 250, 241, .9), 0 0 0 2px rgba(183, 25, 34, .12), 0 6px 18px rgba(156, 14, 21, .1);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .topic-card,
    .topic-card::before,
    .topic-card::after,
    .topic-card__icon { transition: none; }
    .topic-card:hover { transform: none; }
  }

  .bonuses { overflow: hidden; background: #2b211f; color: var(--on-dark); }
  .bonuses .guide-section-heading h2 { color: var(--on-dark); }
  .bonus-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; }
  .bonus-card { min-width: 0; padding: 1.35rem; border: 1px solid rgba(220,181,104,.3); background: #3c302c; }
  .bonus-card > span { color: #d8ad59; font-size: .68rem; font-weight: 800; letter-spacing: .1em; }
  .bonus-card h3 { margin-top: 1.1rem; color: #fff8ed; font-size: 1.18rem; line-height: 1.12; }
  .bonus-card p { margin: .7rem 0 0; color: var(--on-dark-muted); font-size: .78rem; line-height: 1.55; }
  .section-purchase { display: grid; justify-items: center; margin-top: 2.5rem; text-align: center; }
  .bonuses .purchase-note { color: #d7cac0; }

  .preview { padding-top: clamp(3rem, 5vw, 4.75rem); padding-bottom: clamp(4.5rem, 7vw, 7rem); background: #f6ecdd; }
  .preview .guide-section-heading { gap: 0; }
  .preview .guide-section-heading h2 + p { margin-top: 1rem; }
  .preview-list { display: flex; width: min(100%, 72rem); align-items: center; justify-content: center; margin: -1rem auto 0; padding: .5rem 1.5rem 1rem; isolation: isolate; }
  .preview-card { position: relative; display: flex; min-width: 0; flex: 0 1 24rem; flex-direction: column; margin: 0; padding: .7rem; border: 1px solid rgba(138,98,31,.28); background: #fffaf1; box-shadow: 0 18px 45px rgba(75,49,40,.13); }
  .preview-card:nth-child(1) { z-index: 1; transform: translate(1.35rem, .9rem) rotate(-5deg); transform-origin: right bottom; }
  .preview-card:nth-child(2) { z-index: 3; }
  .preview-card:nth-child(3) { z-index: 1; transform: translate(-1.35rem, .9rem) rotate(5deg); transform-origin: left bottom; }
  .preview-card__media { overflow: hidden; aspect-ratio: 562 / 878; border: 1px solid rgba(156,14,21,.2); background: #f1dfc4; }
  .preview-card__media :global(.preview-card__image) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .preview-card figcaption { min-height: 4.35rem; padding: 1rem .45rem .45rem; color: var(--text); font-weight: 700; line-height: 1.35; }

  .author { background: #fffaf1; }
  .author__grid { display: grid; grid-template-columns: minmax(20rem, .85fr) minmax(0, 1.15fr); align-items: center; gap: clamp(3rem, 8vw, 7rem); }
  .author__image { position: relative; overflow: hidden; aspect-ratio: 1; border: .5rem solid #c99b45; border-radius: 50%; box-shadow: 0 22px 55px rgba(75,49,40,.15); }
  .author__image :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 54% 50%; }
  .author__copy h2 { max-width: 15ch; margin-bottom: 1.7rem; }
  .author__copy p { max-width: 43rem; color: var(--text-muted); }
  .author__copy p + p { margin-top: 1rem; }
  .text-link { display: inline-flex; align-items: center; gap: .55rem; margin-top: .6rem; color: var(--vermilion); font-size: .83rem; font-weight: 800; letter-spacing: .045em; text-decoration: none; text-transform: uppercase; }
  .text-link:hover { color: var(--vermilion-bright); }

  .final-cta { background: var(--vermilion); color: white; }
  .final-cta__inner { display: grid; max-width: 58rem; justify-items: center; text-align: center; }
  .final-cta h2 { color: #fff9ef; }
  .final-cta p { max-width: 44rem; margin: 1.5rem 0 1.8rem; color: #f2dfd3; font-size: 1.08rem; }
  .guide-button--light { background: #e7bd67; color: #4d090c; box-shadow: 0 12px 30px rgba(45,4,7,.25); }
  .guide-button--light:hover { background: #f1d08b; color: #4d090c; }
  .final-cta small { margin-top: .8rem; color: #f0d7cc; }

  @media (max-width: 68rem) {
    .guide-hero__grid { grid-template-columns: minmax(0, 1fr) minmax(19rem, .65fr); gap: 2.5rem; }
    .guide-hero h1 { font-size: clamp(3.2rem, 6.5vw, 5rem); }
    .problem__inner { gap: 2.5rem; }
    .problem__visual { min-height: 26rem; }
    .problem-card { padding-inline: .85rem; }
    .bonus-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
